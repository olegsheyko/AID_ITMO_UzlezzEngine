{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Engine: configure (Release)",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}\\build\\vscode",
                "-G",
                "Visual Studio 17 2022",
                "-A",
                "x64",
                "-DENGINE_ENABLE_TRACY=ON",
                "-DENGINE_BUILD_TRACY_DEMOS=OFF"
            ],
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Engine: build (Release)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\build\\vscode",
                "--config",
                "Release",
                "--target",
                "GameEngine",
                "CopyAssets",
                "CopyLuaLicenses",
                "--parallel"
            ],
            "dependsOn": "Engine: configure (Release)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Engine: prepare runtime",
            "type": "process",
            "command": "cmake",
            "args": [
                "-E",
                "copy_if_different",
                "${workspaceFolder}\\external\\assimp\\lib\\assimp-vc143-mt.dll",
                "${workspaceFolder}\\build\\vscode\\Release"
            ],
            "dependsOn": "Engine: build (Release)",
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "Engine: run",
            "type": "process",
            "command": "${workspaceFolder}\\build\\vscode\\Release\\GameEngine.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Engine: prepare runtime",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Engine: run arena (ЛР 2)",
            "type": "process",
            "command": "${workspaceFolder}\\build\\vscode\\Release\\GameEngine.exe",
            "args": ["--editor-arena"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Engine: prepare runtime",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Tracy: prepare profiler",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\setup_tracy_profiler.ps1"
            ],
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "Tracy: connect",
            "type": "process",
            "command": "${workspaceFolder}\\build\\tracy-profiler\\tracy-profiler.exe",
            "args": ["-a", "127.0.0.1"],
            "dependsOn": "Tracy: prepare profiler",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "silent"
            }
        },
        {
            "label": "Engine + Tracy",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\run_engine_with_tracy.ps1"
            ],
            "dependsOn": [
                "Tracy: prepare profiler",
                "Engine: prepare runtime"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Engine + Tracy: culling",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\run_engine_with_tracy.ps1",
                "-Culling"
            ],
            "dependsOn": [
                "Tracy: prepare profiler",
                "Engine: prepare runtime"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Engine: tests",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}\\build\\vscode",
                "-C",
                "Release",
                "--output-on-failure"
            ],
            "dependsOn": "Engine: build (Release)",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
